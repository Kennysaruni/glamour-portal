# Caddyfile configuration for Glamour Homecare Portal
# Automated Let's Encrypt TLS / HTTPS Termination on AWS EC2

portal.glamourhomecare.org {
    # Reverse proxy to the Next.js standalone container
    reverse_proxy localhost:3000 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Security Headers for HIPAA Compliance
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Logging
    log {
        output file /var/log/caddy/glamour_portal.log {
            roll_size 10mb
            roll_keep 5
        }
    }
}
